# 本地联调用：复制成 worker/.dev.vars 后填入真实值（.dev.vars 已被 .gitignore 忽略，不要提交）
# 生成签名密钥：openssl rand -base64 48
SIGNING_SECRET = "在这里填一个足够长的随机字符串"
# 8.0 起账户数据在 Workers KV 里；本地调试时 wrangler dev 会自动创建本地 KV，
# wrangler.toml 里的占位 id 在本地模式下可以直接用（不会真的建云端命名空间）
GITHUB_TOKEN = "github_pat_在这里填你的_PAT（迁移旧 account.json / 镜像时才需要）"
# 本地想看聊天室接口就设成 "true"（线上默认 false，9.0 才开放）
CHAT_ENABLED = "false"
